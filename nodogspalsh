config nodogsplash
  option enabled '1'
  option fwhook_enabled '1'
  option gatewayinterface 'br-lan'
  
  # GANTI NAMA GATEWAY SESUAI KEINGINAN
  option gatewayname 'RtRWNet Hotspot'
  
  option maxclients '250'

  # ? SESSION 3 JAM = 180 menit
  option preauthidletimeout '180'     # 3 jam untuk pre-auth
  option authidletimeout '180'        # 3 jam idle timeout  
  option sessiontimeout '180'         # 3 jam session timeout
  
  # Check interval 5 menit (300 detik)
  option checkinterval '300'

  # ? Binauth script untuk voucher system
  option binauth '/etc/nodogsplash/voucher/validate.sh'

  # ? Allow all untuk authenticated users
  list authenticated_users 'allow all'

  # ? Port yang diizinkan untuk pre-auth (DNS, dll)
  list preauthenticated_users 'allow tcp port 53'
  list preauthenticated_users 'allow udp port 53'
  list preauthenticated_users 'allow udp port 67'

  # ? Port untuk akses ke router
  list users_to_router 'allow tcp port 22'
  list users_to_router 'allow tcp port 23'
  list users_to_router 'allow tcp port 53'
  list users_to_router 'allow udp port 53'
  list users_to_router 'allow udp port 67'
  list users_to_router 'allow tcp port 80'
  list users_to_router 'allow tcp port 443'

  # MAC trusted (opsional)
  # list trustedmac 'BC:C7:DA:0C:F0:D9'
